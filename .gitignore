.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
__pycache__/
ignore_folder/

# CI pyramid raster cache (GitHub Actions only)
_pyramid_raster_cache/

# Build output
dist/*
!dist/service-worker.js
!dist/styles.css
!dist/favicon.svg
!dist/favicon-dark.svg
!dist/favicon.ico
!dist/manifest.json

# Data directories
data/boundaries/
data/caches/
data/rugby/team_addresses/
# Ignore everything in distance_cache except the global routed cache below.
# (Glob form, not directory form, so we can re-include specific files.)
data/rugby/distance_cache/*
!data/rugby/distance_cache/routed/
data/rugby/distance_cache/routed/*
data/rugby/standings_cache/
data/rugby/*.md

# Local scrape.py meta-league cache; not needed by CI/build
data/rugby/league_data/*/_meta_leagues_cache.json

# Routed (road) distance matrix is global and stable across seasons --
# commit it so the build works without requiring everyone to run OSRM locally.
!data/rugby/distance_cache/routed/all.npz
!data/rugby/distance_cache/routed/all.json
data/football/*
!data/football/geocoded_teams/
!data/football/geocoded_teams/**
data/scotland/*

.cursor/*

# Local review screenshots (see scripts/capture_review_screenshots.py)
screenshots/review/

# WIP Instagram pyramid exports (local PNG/SVG experiments; not for deploy)
output/instagram/

scotland/*
!scotland/__init__.py
!scotland/*.py
football/*
!football/__init__.py
!football/*.py
